ASPNETCORE_ENVIRONMENT=Development

# API Gateway
API_GATEWAY_HTTP_PORT=8080

# Authentication Service
AUTH_SERVICE_HOST_PORT=8081
AUTH_SERVICE_CONTAINER_PORT=8080
AUTH_DB_HOST=authentication-db
AUTH_DB_PORT=5433
AUTH_DB_NAME=authentication_db
AUTH_DB_USER=authentication
AUTH_DB_PASSWORD=authentication_password
JWT_KEY=replace_with_strong_jwt_key
JWT_ISSUER=https://auth.myapp.dev
JWT_AUDIENCE=https://api.myapp.dev
JWT_ACCESS_TOKEN_MINUTES=2
JWT_REFRESH_TOKEN_MINUTES=3

# User Service
USER_SERVICE_HOST_PORT=8082
USER_SERVICE_CONTAINER_PORT=8080

# Notification Service
NOTIFICATION_SERVICE_HOST_PORT=8083
NOTIFICATION_SERVICE_CONTAINER_PORT=8080
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_ENABLE_SSL=true
SMTP_USERNAME=your_user_name
SMTP_PASSWORD=your_password
SMTP_FROM_EMAIL=your_email
SMTP_FROM_NAME=Food Delivery - Email Verification

# PostgreSQL for User Service
USER_DB_HOST=user-db
USER_DB_PORT=5432
USER_DB_NAME=user_db
USER_DB_USER=user_service
USER_DB_PASSWORD=user_service_password

# RabbitMQ
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
RABBITMQ_VHOST=/

# Delivery Service
DELIVERY_SERVICE_HOST_PORT=8084
DELIVERY_SERVICE_CONTAINER_PORT=8080

# PostgreSQL for Delivery Service (Persistence & History)
DELIVERY_DB_HOST=delivery-db
DELIVERY_DB_PORT=5435
DELIVERY_DB_NAME=delivery_db
DELIVERY_DB_USER=delivery_admin
DELIVERY_DB_PASSWORD=delivery_strong_password

# Redis for Delivery Service (Real-time Geo-location)
REDIS_HOST=delivery-redis
REDIS_PORT=6379
REDIS_PASSWORD=redis_secure_password

# Operational Settings
SHIPPER_SYNC_INTERVAL_SECONDS=30
SHIPPER_ACTIVE_THRESHOLD_SECONDS=60