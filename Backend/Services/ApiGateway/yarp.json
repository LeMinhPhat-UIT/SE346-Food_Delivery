{
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "authentication-cluster",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/auth/{**catch-all}"
          }
        ]
      },
      "user-route": {
        "ClusterId": "user-cluster",
        "Match": {
          "Path": "/api/users/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/users/{**catch-all}"
          }
        ]
      },
      "files-route": {
        "ClusterId": "file-cluster",
        "Match": {
          "Path": "/api/files/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/files/{**catch-all}"
          }
        ]
      },
      "delivery-files-route": {
        "ClusterId": "file-cluster",
        "Match": {
          "Path": "/api/deliveries/files/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/deliveries/files/{**catch-all}"
          }
        ]
      },
      "catalog-route": {
        "ClusterId": "catalog-cluster",
        "Match": {
          "Path": "/api/catalog/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/catalog/{**catch-all}" }
        ]
      },
      "delivery-route": {
        "ClusterId": "delivery-cluster",
        "Match": {
          "Path": "/api/deliveries/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/deliveries/{**catch-all}" }
        ]
      },
      "delivery-hub-route": {
        "ClusterId": "delivery-cluster",
        "Match": {
          "Path": "/hubs/tracking/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/hubs/tracking/{**catch-all}" }
        ]
      },
      "notification-route": {
        "ClusterId": "notification-cluster",
        "Match": {
          "Path": "/api/notifications/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/notifications/{**catch-all}" }
        ]
      }
    },
    "Clusters": {
      "authentication-cluster": {
        "Destinations": {
          "authentication-service": {
            "Address": "http://authentication-service:8080"
          }
        }
      },
      "user-cluster": {
        "Destinations": {
          "user-service": {
            "Address": "http://user-service:8080"
          }
        }
      },
      "file-cluster": {
        "Destinations": {
          "file-service": {
            "Address": "http://file-service:8080"
          }
        }
      },
      "catalog-cluster": {
        "Destinations": {
          "catalog-service": {
            "Address": "http://catalog-service:8080"
          }
        }
      },
      "delivery-cluster": {
        "Destinations": {
          "delivery-service": {
            "Address": "http://delivery-service:8080"
          }
        }
      },
      "notification-cluster": {
        "Destinations": {
          "notification-service": {
            "Address": "http://notification-service:8080"
          }
        }
      }
    }
  }
}
