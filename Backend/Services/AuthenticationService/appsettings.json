{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AuthenticationSettings": {
    "LockoutSettings": {
      "IsLockoutOnFailure": true,
      "DefaultLockoutTimeSpanInMinutes": 5,
      "DefaultMaxFailedAccessAttempt": 5
    },
    "PasswordSettings": {
      "RequireDigit": true,
      "RequireLowercase": true,
      "RequireUppercase": true,
      "RequireNonAlphanumeric": false,
      "RequiredLength": 6
    },
    "SignInSettings": {
      "RequireConfirmedEmail": true
    },
    "UserSettings": {
      "RequireUniqueEmail": true
    },
    "OtpSettings": {
      "DefaultOtpExpiredTimeSpanInSeconds": 100
    }
  },
  "RabbitMQ": {
    "HostName": "rabbitmq",
    "Port": 5672,
    "UserName": "guest",
    "Password": "guest",
    "VirtualHost": "/",
    "Exchanges": [
      {
        "Name": "notify-exchange",
        "Type": "topic",
        "Durable": true,
        "Queues": [
          {
            "Name": "auth-merchant-request-review-queue",
            "RoutingKeys": [ "merchant.request.reviewed" ]
          },
          {
            "Name": "auth-shipper-request-review-queue",
            "RoutingKeys": [ "shipper.request.reviewed" ]
          }
        ]
      }    
    ]  
  }
}
