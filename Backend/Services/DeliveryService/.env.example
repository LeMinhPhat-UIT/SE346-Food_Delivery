ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_HTTP_PORTS=8080
ConnectionStrings__DeliveryDbConnectionString=Host=delivery-db;Port=5432;Database=delivery_db;Username=delivery_service;Password=delivery_strong_password
ConnectionStrings__RedisConnection=delivery-redis:6379,password=redis_secure_password
DELIVERY_REDIS_HOST=delivery-redis
DELIVERY_REDIS_PORT=6379
DELIVERY_REDIS_PASSWORD=redis_secure_password
RabbitMq__HostName=rabbitmq
RabbitMq__Port=5672
RabbitMq__UserName=appuser
RabbitMq__Password=app_password
JwtSettings__Key=replace_with_strong_jwt_key
JwtSettings__Issuer=https://auth.myapp.dev
JwtSettings__Audience=https://api.myapp.dev
GOOGLE_APPLICATION_CREDENTIALS=/app/secrets/firebase-auth.json
OpenRouteService_ApiKey=replace_with_openrouteservice_api_key
OpenRouteService_Url=https://api.openrouteservice.org
OpenRouteService_Profile=driving-car
OpenRouteService_TimeoutSeconds=10
