{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "RabbitMq": {
    "HostName": "rabbitmq",
    "Port": 5672,
    "UserName": "guest",
    "Password": "guest",
    "Exchanges": [
      {
        "Name": "delivery-exchange",
        "Type": "topic",
        "Durable": true,
        "Queues": [
          {
            "Name": "order-queue",
            "RoutingKeys": [ "order.completed" ]
          }
        ]
      }
    ]
  },
  "DeliveryOptions": {
    "DeliveryRadius": 30,
    "FindingShipperRadius": 5,
    "GeoUnit": "km"
  }
  "AllowedHosts": "*"
}
