{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "RabbitMq": {
    "HostName": "rabbitmq",
    "Port": 5672,
    "UserName": "guest",
    "Password": "guest",
    "Exchanges": [
      {
        "Name": "notify-exchange",
        "Type": "topic",
        "Durable": true,
        "Queues": [
          {
            "Name": "otp-queue",
            "RoutingKeys": [ "otp.send-requested" ]
          },
          {
            "Name": "lockout-queue",
            "RoutingKeys": [ "user.locked-out" ]
          },
          {
            "Name": "order-queue",
            "RoutingKeys":  [ "order.completed", "order.being-shipped", "shipper.found", "delivery.milestone" ]
          }
        ]
      }
    ]
  },
  "SmtpSettings": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "EnableSsl": true,
    "UserName": "your_user_name",
    "Password": "your_password",
    "FromEmail": "your_email",
    "FromName": "Food Delivery - Email Verification"
  }
}
