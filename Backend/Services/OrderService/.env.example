NODE_ENV=development
PORT=8080
DATABASE_URL=postgresql://postgres:order_strong_password@order-db:5432/order_db?schema=public
DIRECT_URL=
JWT_SECRET=replace_with_strong_jwt_key
JWT_ISSUER=https://auth.myapp.dev
JWT_AUDIENCE=https://api.myapp.dev
RABBITMQ_URL=amqp://appuser:app_password@rabbitmq:5672
RABBITMQ_EXCHANGE=notify-exchange
USER_SERVICE_URL=http://user-service:8080/api
CATALOG_SERVICE_URL=http://catalog-service:8080/api/catalog
DELIVERY_SERVICE_URL=http://delivery-service:8080/api/deliveries
REDIS_HOST=order-redis
REDIS_PORT=6379
REDIS_PASSWORD=order_redis_secure_password
CART_TTL_SECONDS=604800
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_TMN_CODE=YOUR_VNPAY_TMN_CODE
VNPAY_HASH_SECRET=YOUR_VNPAY_HASH_SECRET
VNPAY_RETURN_URL=http://localhost:8086/api/orders/payments/vnpay/return
VNPAY_IPN_URL=http://localhost:8086/api/orders/payments/vnpay/ipn
VNPAY_VERSION=2.1.0
VNPAY_COMMAND=pay
VNPAY_CURRENCY=VND
VNPAY_LOCALE=vn
VNPAY_ORDER_TYPE=180000
VNPAY_EXPIRE_MINUTES=15
