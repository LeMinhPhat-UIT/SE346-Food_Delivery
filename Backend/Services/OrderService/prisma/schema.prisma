generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enums

enum PaymentMethod {
  COD
  VNPAY
}

enum OrderPaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  PICKED_UP
  DELIVERING
  DELIVERED
  CANCELLED
}

enum CancelledBy {
  CUSTOMER
  MERCHANT
  SHIPPER
  SYSTEM
}

enum PaymentTransactionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum DiscountTarget {
  SUBTOTAL
  DELIVERY_FEE
}

enum OutboxStatus {
  PENDING
  PUBLISHED
}

model Order {
  id          String  @id @default(uuid()) @db.Uuid
  orderNumber String  @unique @db.VarChar(20)
  userId      String  @db.Uuid
  merchantId  String  @db.Uuid
  shipperId   String? @db.Uuid

  // Snapshot
  merchantName   String  @db.VarChar(255)
  merchantAvatar String? @db.VarChar(500)

  // Delivery Info
  deliveryAddress  String   @db.VarChar(255)
  deliveryWard     String?  @db.VarChar(100)
  deliveryDistrict String?  @db.VarChar(100)
  deliveryCity     String?  @db.VarChar(100)
  deliveryLat      Decimal? @db.Decimal(10, 8)
  deliveryLng      Decimal? @db.Decimal(11, 8)

  recipientName  String @db.VarChar(100)
  recipientPhone String @db.VarChar(20)

  subtotal       Decimal @db.Decimal(12, 2)
  deliveryFee    Decimal @db.Decimal(12, 2)
  discountAmount Decimal @default(0) @db.Decimal(12, 2)
  totalAmount    Decimal @db.Decimal(12, 2)

  paymentMethod PaymentMethod
  paymentStatus OrderPaymentStatus @default(PENDING)

  status       OrderStatus  @default(PENDING)
  cancelReason String?      @db.Text
  cancelledBy  CancelledBy?

  note      String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  voucherId String?  @db.Uuid
  voucher   Voucher? @relation(fields: [voucherId], references: [id])

  voucherUsage VoucherUsage?

  items         OrderItem[]
  statusHistory OrderStatusHistory[]
  payments      Payment[]
}

model OrderItem {
  id        String @id @default(uuid()) @db.Uuid
  orderId   String @db.Uuid
  productId String @db.Uuid

  // Snapshot
  productName     String  @db.VarChar(255)
  productImage    String? @db.VarChar(500)
  unitPrice       Decimal @db.Decimal(12, 2)
  selectedOptions Json?

  quantity  Int
  note      String?  @db.Text
  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id])
}

model OrderStatusHistory {
  id      String @id @default(uuid()) @db.Uuid
  orderId String @db.Uuid

  status OrderStatus

  note      String?  @db.Text
  createdBy String?  @db.Uuid
  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id])
}

model Voucher {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique @db.VarChar(50)
  name        String  @db.VarChar(255)
  description String? @db.Text

  discountType   DiscountType
  discountValue  Decimal      @db.Decimal(12, 2)
  maxDiscount    Decimal?     @db.Decimal(12, 2)
  minOrderAmount Decimal?     @db.Decimal(12, 2)

  discountTarget DiscountTarget @default(SUBTOTAL)

  merchantId String? @db.Uuid

  usageLimit   Int?
  perUserLimit Int  @default(1)

  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(true)

  createdAt DateTime  @default(now())
  deletedAt DateTime? // Soft delete

  usages VoucherUsage[]
  orders Order[]
}

model VoucherUsage {
  id        String @id @default(uuid()) @db.Uuid
  voucherId String @db.Uuid
  userId    String @db.Uuid
  orderId   String @unique @db.Uuid

  discountAmount Decimal  @db.Decimal(12, 2)
  usedAt         DateTime @default(now())

  voucher Voucher @relation(fields: [voucherId], references: [id])
  order   Order   @relation(fields: [orderId], references: [id])
}

model Payment {
  id             String @id @default(uuid()) @db.Uuid
  orderId        String @db.Uuid
  idempotencyKey String @unique @db.VarChar(100)

  method PaymentMethod
  status PaymentTransactionStatus @default(PENDING)

  amount        Decimal   @db.Decimal(12, 2)
  transactionId String?   @db.VarChar(100)
  paymentData   Json?
  paidAt        DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  order Order @relation(fields: [orderId], references: [id])
}

model OutboxMessage {
  id            String @id @default(uuid()) @db.Uuid
  aggregateType String @db.VarChar(100)
  aggregateId   String @db.Uuid
  eventType     String @db.VarChar(100)
  payload       Json // Nội dung Event bắn sang .NET

  status OutboxStatus @default(PENDING)

  createdAt DateTime @default(now())
}
